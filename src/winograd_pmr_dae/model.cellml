                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <minus/>
                                            <apply>
                                                <plus/>
                                                <ci>V</ci>
                                                <cn cellml:units="dimensionless">35</cn>
                                            </apply>
                                        </apply>
                                        <cn cellml:units="dimensionless">20</cn>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <lt/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <plus/>
                                        <ci>V</ci>
                                        <cn cellml:units="dimensionless">35</cn>
                                    </apply>
