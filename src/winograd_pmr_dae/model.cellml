                            <and/>
                            <apply>
                                <lt/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <plus/>
                                            <ci>V</ci>
                                            <cn cellml:units="dimensionless">35</cn>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="dimensionless">10</cn>
                                </apply>
                                <cn cellml:units="dimensionless">25</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <plus/>
                                            <ci>V</ci>
                                            <cn cellml:units="dimensionless">35</cn>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="dimensionless">10</cn>
                                </apply>
                                <apply>
                                    <minus/>
                                    <cn cellml:units="dimensionless">25</cn>
                                </apply>
                            </apply>
